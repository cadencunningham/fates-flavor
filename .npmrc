# npm 10.2.4 (Node 20.11.1) crashes with "Cannot read properties of null
# (reading 'edgesOut')" in @npmcli/arborist when resolving vitest 4's
# large *optional* peer-dependency graph (msw, @vitejs/devtools-*,
# @vitest/browser-*, canvas, etc. — all peerDependenciesMeta.optional=true).
# legacy-peer-deps sidesteps the arborist code path that triggers the crash.
# See docs/plans/2026-09-14-fates-flavor.md Phase 1 discovery notes.
legacy-peer-deps=true
